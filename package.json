{
  "name": "taxi-chaos",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "assets:prepare": "node tools/assets-prepare.mjs",
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run --maxWorkers=4 --testTimeout=20000",
    "map:check": "node tools/map-check.mjs",
    "artwork:prep": "node tools/artwork-prep.mjs",
    "artwork:optimize": "node tools/artwork-optimize.mjs",
    "dialogue:preview": "node tools/dialogue-preview.mjs",
    "scenario:run": "node tools/scenario-run.mjs",
    "scenario:test": "node --test tools/scenario-cli-check.mjs",
    "artwork:test": "node --test tools/artwork-prep-check.mjs tools/artwork-cache-check.mjs",
    "authoring:preview": "node tools/authoring-preview.mjs",
    "authoring:test": "node --test tools/authoring-preview-check.mjs",
    "tools:test": "npm run artwork:test && npm run scenario:test && npm run authoring:test",
    "browser:test": "node tests/browser/run.mjs",
    "performance:bench": "node tools/artwork-performance.mjs",
    "perf:bench": "node tools/perf-bench.mjs",
    "perf:profile": "node tools/perf-profile.mjs",
    "predev": "npm run assets:prepare",
    "prebuild": "npm run assets:prepare",
    "pretest": "npm run assets:prepare",
    "pretools:test": "npm run assets:prepare",
    "premap:check": "npm run assets:prepare",
    "prebrowser:test": "npm run assets:prepare",
    "preartwork:test": "npm run assets:prepare",
    "prescenario:test": "npm run assets:prepare",
    "preauthoring:test": "npm run assets:prepare",
    "preauthoring:preview": "npm run assets:prepare",
    "predialogue:preview": "npm run assets:prepare",
    "prescenario:run": "npm run assets:prepare",
    "preperformance:bench": "npm run assets:prepare",
    "preperf:bench": "npm run assets:prepare",
    "preperf:profile": "npm run assets:prepare"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "playwright": "^1.64.0",
    "typescript": "^5.8.3",
    "vite": "^8.3.3",
    "vitest": "^5.0.3"
  }
}
