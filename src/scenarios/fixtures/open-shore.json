{
  "version": 1,
  "name": "Open Shore café investigation",
  "options": { "traffic": "quiet", "noPolice": true },
  "steps": [
    { "op": "expect", "path": "job.missionId", "equals": "bea-first-shift" },
    { "op": "pickup", "label": "Accept Bea's opening ride" },
    { "op": "read" },
    { "op": "deliver" },
    { "op": "expect", "path": "job.everyday", "exists": true },
    { "op": "dispatch", "label": "Answer the waiting ordinary call" },
    { "op": "pickup", "label": "Work the ordinary follow-up" },
    { "op": "read" },
    { "op": "deliver" },
    { "op": "expect", "path": "job.missionId", "equals": "celia-barriers" },
    { "op": "dispatch", "label": "Answer the suggested story call" },
    { "op": "pickup", "label": "Accept the barriers booking through normal dispatch" },
    { "op": "read" },
    { "op": "capture", "name": "barriers-pickup", "view": "story" },
    { "op": "step", "seconds": 8.1 },
    { "op": "place", "at": "dropoff" },
    { "op": "step", "seconds": 0.01 },
    { "op": "expect", "path": "dialogue.beatId", "equals": "ride-celia-barriers-during" },
    { "op": "read" },
    { "op": "capture", "name": "barriers-during", "view": "story" },
    { "op": "deliver" },
    { "op": "read" },
    { "op": "expect", "path": "notebookIds", "includes": "barrier-receipt" },
    { "op": "capture", "name": "barriers-arrival", "view": "story" },
    { "op": "place", "at": "garage" },
    { "op": "mode", "mode": "paused" },
    { "op": "capture", "name": "sleep-preview", "view": "pause" },
    { "op": "sleep" },
    { "op": "mode", "mode": "paused" },
    { "op": "sleep" },
    { "op": "expect", "path": "campaign.minute", "equals": 3300 },
    { "op": "expect", "path": "campaign.world.cafe", "equals": "boarded" },
    { "op": "expect", "path": "materialIds", "equals": ["barrier-receipt"] },
    { "op": "place", "at": "garden-cafe" },
    { "op": "photo" },
    { "op": "capture", "name": "boarded-cafe", "focus": "cafe", "zoom": 20 },
    { "op": "route", "mission": "nico-safe-ride" },
    { "op": "expect", "path": "choices.nico-trip", "exists": false },
    { "op": "pickup" },
    { "op": "read" },
    { "op": "capture", "name": "nico-pickup", "view": "story" },
    { "op": "expect", "path": "choices.nico-trip", "equals": "room" },
    { "op": "reload", "label": "Round-trip an accepted authored ride through the save migrators" },
    { "op": "expect", "path": "job.missionId", "equals": "nico-safe-ride" },
    { "op": "expect", "path": "job.stage", "equals": "dropoff" },
    { "op": "expect", "path": "choices.nico-trip", "equals": "room" },
    { "op": "deliver" },
    { "op": "read" },
    { "op": "expect", "path": "flags", "includes": "nico-safe" },
    { "op": "expect", "path": "notebookIds", "includes": "cleaner-note" },
    { "op": "submit", "material": "barrier-receipt", "expected": false, "label": "Reject submission away from the newsroom" },
    { "op": "place", "at": "newsroom" },
    { "op": "submit", "material": "barrier-receipt" },
    { "op": "submit", "material": "cleaner-note" },
    { "op": "submit", "material": "cafe-photo" },
    { "op": "expect", "path": "campaign.publications", "length": 0 },
    { "op": "capture", "name": "newsroom-received", "view": "notebook" },
    { "op": "advance", "minutes": 180, "label": "Let source checks finish without running three minutes of physics" },
    { "op": "expect", "path": "campaign.newsroom.cases.coordination.editionAt", "equals": 4680 },
    { "op": "expect", "path": "campaign.publications", "length": 0 },
    { "op": "expect", "path": "campaign.publications", "length": 0 },
    { "op": "advance", "to": { "day": 4, "hour": 6 }, "label": "Resolve the automatic 06:00 edition" },
    { "op": "expect", "path": "campaign.publications", "length": 1 },
    { "op": "expect", "path": "campaign.world.security", "equals": "contracted" },
    { "op": "capture", "name": "published-response-pending", "view": "notebook" },
    { "op": "advance", "minutes": 120 },
    { "op": "expect", "path": "campaign.world.security", "equals": "suspended" },
    { "op": "expect", "path": "campaign.occurrences.reaction-coordination.at", "equals": 4800 },
    { "op": "place", "at": "garden-cafe" },
    { "op": "capture", "name": "contract-suspended", "focus": "cafe", "zoom": 20 },
    { "op": "expect", "path": "notebookIds", "includes": "cafe-photo" }
  ]
}
