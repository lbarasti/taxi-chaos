{
  "version": 1,
  "name": "Missed café events grant no knowledge",
  "steps": [
    { "op": "advance", "to": { "day": 7 } },
    { "op": "expect", "path": "campaign.world.cafe", "equals": "closed" },
    { "op": "expect", "path": "campaign.occurrences.tenancy-hearing.outcome", "equals": "closed" },
    { "op": "expect", "path": "notebookIds", "length": 0 },
    { "op": "expect", "path": "campaign.newsroom.received", "equals": {} },
    { "op": "expect", "path": "campaign.publications", "length": 0 },
    { "op": "facts", "facts": { "flags": { "tenant-interview-reached": true } }, "label": "A late hypothesis cannot reverse a resolved hearing" },
    { "op": "advance", "minutes": 60 },
    { "op": "expect", "path": "campaign.occurrences.tenancy-hearing.outcome", "equals": "closed" },
    { "op": "place", "at": "garden-cafe" },
    { "op": "capture", "name": "missed-cafe", "focus": "cafe", "zoom": 20 },
    { "op": "capture", "name": "empty-notebook", "view": "notebook" }
  ]
}
