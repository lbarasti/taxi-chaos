{
  "version": 1,
  "name": "Borrowed linen: a paid wash and a clean return",
  "options": { "traffic": "quiet", "noPolice": true },
  "steps": [
    { "op": "advance", "to": { "day": 2 } },
    { "op": "place", "at": "moonlight-hotel" },
    { "op": "abandon", "label": "Take the nearby dispatch suggestion at Moonlight" },
    { "op": "expect", "path": "job.missionId", "equals": "linen-sam-clockoff" },
    { "op": "pickup" },
    { "op": "read" },
    { "op": "capture", "name": "sam-clockoff", "view": "story" },
    { "op": "deliver" },
    { "op": "route", "mission": "linen-mags-loan" },
    { "op": "pickup" },
    { "op": "read" },
    { "op": "capture", "name": "mags-loan", "view": "story" },
    { "op": "deliver" },
    { "op": "advance", "event": "linen-reunion-opens" },
    { "op": "expect", "path": "campaign.world.linen-tables", "equals": "borrowed" },
    { "op": "capture", "name": "reunion-tables", "focus": "linen-hall", "zoom": 20 },
    { "op": "advance", "event": "linen-reunion-closes" },
    { "op": "route", "mission": "linen-return" },
    { "op": "pickup" },
    { "op": "read" },
    { "op": "capture", "name": "oscar-wash-choice", "view": "story" },
    { "op": "stopover", "action": "begin", "expected": false, "label": "The wash cannot start away from East Village" },
    { "op": "stopover", "action": "route" },
    { "op": "expect", "path": "job.stopover.routed", "equals": true },
    { "op": "stopover", "action": "route", "label": "Direct to Moonlight remains a reversible choice" },
    { "op": "expect", "path": "job.stopover.routed", "equals": false },
    { "op": "expect", "path": "job.stopover.started", "equals": false },
    { "op": "stopover", "action": "route" },
    { "op": "place", "at": "east-village" },
    { "op": "capture", "name": "wash-room", "focus": "linen-washroom", "zoom": 18 },
    { "op": "stopover", "action": "begin" },
    { "op": "step", "seconds": 9 },
    { "op": "expect", "path": "job.stopover.completed", "equals": false },
    { "op": "expect", "path": "job.stopover.elapsed", "gte": 8.99 },
    { "op": "capture", "name": "washing" },
    { "op": "reload", "label": "Retain partial wash progress through a serialized save" },
    { "op": "expect", "path": "job.stopover.started", "equals": true },
    { "op": "expect", "path": "job.stopover.elapsed", "gte": 8.99 },
    { "op": "step", "seconds": 9.1 },
    { "op": "expect", "path": "campaign.world.linen-washed", "equals": true },
    { "op": "expect", "path": "job.stopover.completed", "equals": true },
    { "op": "deliver" },
    { "op": "read" },
    { "op": "capture", "name": "clean-return", "view": "story" },
    { "op": "expect", "path": "campaign.world.linen-returned", "equals": true },
    { "op": "advance", "event": "linen-stock-count" },
    { "op": "expect", "path": "campaign.world.linen-stock", "equals": "clean" },
    { "op": "capture", "name": "laundry-aftermath", "focus": "linen-laundry", "zoom": 18 },
    { "op": "expect", "path": "materialIds", "equals": [] },
    { "op": "expect", "path": "campaign.newsroom.received", "equals": {} },
    { "op": "expect", "path": "campaign.publications", "length": 0 }
  ]
}
