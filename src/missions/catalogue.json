      "character": "frankie", "category": "plot", "channel": "passenger",
      "text": "You chose the paper trail. Good. There's a ledger at the docks that Meridian would rather we didn't see."
    },
    "frankie-arcade": {
      "character": "frankie", "category": "side-quest", "channel": "sender",
      "text": "Thanks for giving my friend a lift to the arcade. Even a city full of secrets needs a night off."
