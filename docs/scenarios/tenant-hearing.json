{
  "version": 1,
  "name": "Tenant reached before the hearing",
  "steps": [
    { "op": "advance", "event": "cafe-boarded" },
    { "op": "facts", "facts": { "flags": { "tenant-interview-reached": true } }, "label": "Inject a reached-tenant hypothesis before the hearing" },
    { "op": "advance", "event": "tenancy-hearing" },
    { "op": "expect", "path": "campaign.world.cafe", "equals": "tenancy-review" },
    { "op": "expect", "path": "campaign.occurrences.tenancy-hearing.outcome", "equals": "tenancy-review" },
    { "op": "expect", "path": "notebookIds", "length": 0 },
    { "op": "place", "at": "garden-cafe" },
    { "op": "capture", "name": "tenancy-review", "focus": "cafe", "zoom": 20 }
  ]
}
